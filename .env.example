# Environment configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./data/logs.db

# Server security & Sessions
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
SESSION_COOKIE_NAME=log_anomaly_session

# OIDC / Keycloak SSO Configuration
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/master/.well-known/openid-configuration
OIDC_CLIENT_ID=log-anomaly-detector
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Opt-in LLM Advisory Configuration (Server-side only)
# Default operator endpoint targets LiteLLM proxy; keys are never hardcoded.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://llm.chris-vo.com/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
